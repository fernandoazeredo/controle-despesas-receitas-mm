rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email
        : '';
    }

    function isPrimaryAdminEmail() {
      return authEmail() == 'fernandoazeredo64@gmail.com';
    }

    function currentUser() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && currentUser().data.status == 'active';
    }

    function hasRole(roles) {
      return activeUser() && currentUser().data.role in roles;
    }

    function validAttachmentSize() {
      return request.resource == null || request.resource.size <= 20 * 1024 * 1024;
    }

    // Anexos de despesas e recebimentos usam a autenticacao do Firebase como
    // criterio principal. Isso evita depender de uma consulta cruzada ao
    // Firestore durante o upload, que pode gerar storage/unauthorized mesmo
    // para um usuario ja autenticado no aplicativo.
    // O usuario grava na propria pasta; o Master pode administrar qualquer pasta.
    match /despesas/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && (request.auth.uid == userId || isPrimaryAdminEmail())
        && validAttachmentSize();
      allow delete: if signedIn()
        && (request.auth.uid == userId || isPrimaryAdminEmail());
    }

    match /recebimentos/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && (request.auth.uid == userId || isPrimaryAdminEmail())
        && validAttachmentSize();
      allow delete: if signedIn()
        && (request.auth.uid == userId || isPrimaryAdminEmail());
    }

    match /demonstrativos/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validAttachmentSize();
      allow delete: if isPrimaryAdminEmail();
    }

    // Pacotes contabeis permanecem com a regra financeira mais restrita,
    // pois este fluxo ja esta validado em producao.
    match /pacotes-contabeis/{allPaths=**} {
      allow read: if hasRole(['master', 'diretor', 'gerente', 'tesouraria']);
      allow write: if hasRole(['master', 'gerente', 'tesouraria']);
    }
  }
}
