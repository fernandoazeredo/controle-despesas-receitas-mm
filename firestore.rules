rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && currentUser().data.status == 'active';
    }

    function hasRole(roles) {
      return activeUser() && currentUser().data.role in roles;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || hasRole(['master', 'admin']));
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (request.auth.uid == userId || hasRole(['master', 'admin']));
      allow delete: if hasRole(['master']);
    }

    match /expenses/{document=**} {
      allow read: if activeUser();
      allow create, update: if hasRole(['master', 'admin', 'tesouraria']);
      allow delete: if hasRole(['master', 'admin']);
    }

    match /receivables/{document=**} {
      allow read: if activeUser();
      allow create, update: if hasRole(['master', 'admin', 'alvaras', 'tesouraria']);
      allow delete: if hasRole(['master', 'admin']);
    }

    match /approvals/{document=**} {
      allow read: if activeUser();
      allow create, update: if hasRole(['master', 'admin', 'diretoria', 'tesouraria']);
      allow delete: if hasRole(['master']);
    }

    match /chartOfAccounts/{document=**} {
      allow read: if activeUser();
      allow write: if hasRole(['master', 'admin']);
    }

    match /auditLogs/{document=**} {
      allow read: if hasRole(['master', 'admin', 'diretoria']);
      allow create: if activeUser();
      allow update, delete: if false;
    }

    match /settings/{document=**} {
      allow read: if activeUser();
      allow write: if hasRole(['master', 'admin']);
    }
  }
}
