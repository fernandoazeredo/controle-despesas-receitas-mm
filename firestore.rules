rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPrimaryAdminEmail() {
      return signedIn() && request.auth.token.email == 'fernandoazeredo64@gmail.com';
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && currentUser().data.status == 'active';
    }

    function hasRole(roles) {
      return activeUser() && currentUser().data.role in roles;
    }

    function validSelfRegistration(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && (
          (isPrimaryAdminEmail()
            && request.resource.data.role == 'master'
            && request.resource.data.status == 'active')
          ||
          (!isPrimaryAdminEmail()
            && request.resource.data.role == 'consulta'
            && request.resource.data.status == 'pending')
        );
    }

    function safeSelfUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['displayName', 'photoURL', 'lastLoginAt']);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || hasRole(['master', 'admin']));
      allow create: if validSelfRegistration(userId);
      allow update: if signedIn() && (
        (request.auth.uid == userId && safeSelfUpdate())
        || hasRole(['master', 'admin'])
      );
      allow delete: if hasRole(['master']) && request.auth.uid != userId;
    }

    match /userInvites/{document=**} {
      allow read, create, update: if hasRole(['master', 'admin']);
      allow delete: if hasRole(['master']);
    }

    match /expenses/{document=**} {
      allow read: if activeUser();
      allow create, update: if hasRole(['master', 'admin', 'tesouraria']);
      allow delete: if hasRole(['master', 'admin']);
    }

    match /receivables/{document=**} {
      allow read: if activeUser();
      allow create, update: if hasRole(['master', 'admin', 'alvaras', 'tesouraria']);
      allow delete: if hasRole(['master', 'admin']);
    }

    match /approvals/{document=**} {
      allow read: if activeUser();
      allow create, update: if hasRole(['master', 'admin', 'diretoria', 'tesouraria']);
      allow delete: if hasRole(['master']);
    }

    match /chartOfAccounts/{document=**} {
      allow read: if activeUser();
      allow write: if hasRole(['master', 'admin']);
    }

    match /accountingDispatches/{document=**} {
      allow read, create: if hasRole(['master', 'admin', 'contabilidade']);
      allow update: if hasRole(['master', 'admin']);
      allow delete: if hasRole(['master']);
    }

    match /auditLogs/{document=**} {
      allow read: if hasRole(['master', 'admin', 'diretoria']);
      allow create: if activeUser();
      allow update, delete: if false;
    }

    match /settings/{document=**} {
      allow read: if activeUser();
      allow write: if hasRole(['master', 'admin']);
    }
  }
}
