rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email
        : '';
    }

    function isPrimaryAdminEmail() {
      return authEmail() == 'fernandoazeredo64@gmail.com';
    }

    function isDirectorEmail() {
      return authEmail() == 'flavio.marques@marquesemuller.adv.br';
    }

    function isManagerEmail() {
      return authEmail() == 'reinaldo@marquesemuller.adv.br';
    }

    function isTreasuryEmail() {
      return authEmail() == 'socorro@marquesemuller.adv.br';
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && currentUser().data.status == 'active';
    }

    function hasRole(roles) {
      return activeUser() && currentUser().data.role in roles;
    }

    function validSelfRegistration(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && (
          (isPrimaryAdminEmail()
            && request.resource.data.role == 'master'
            && request.resource.data.status == 'active')
          ||
          (isDirectorEmail()
            && request.resource.data.role == 'diretor'
            && request.resource.data.status == 'pending')
          ||
          (isManagerEmail()
            && request.resource.data.role == 'gerente'
            && request.resource.data.status == 'pending')
          ||
          (isTreasuryEmail()
            && request.resource.data.role == 'tesouraria'
            && request.resource.data.status == 'pending')
          ||
          (!isPrimaryAdminEmail()
            && !isDirectorEmail()
            && !isManagerEmail()
            && !isTreasuryEmail()
            && request.resource.data.role == 'operador'
            && request.resource.data.status == 'pending')
        );
    }

    function safeSelfUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['displayName', 'photoURL', 'lastLoginAt']);
    }

    function directorExpenseDecision() {
      return isDirectorEmail()
        && hasRole(['diretor'])
        && resource.data.status in ['enviado_aprovacao', 'em_analise']
        && request.resource.data.status in ['aprovado', 'devolvido', 'rejeitado'];
    }

    function operationalExpenseUpdate() {
      return hasRole(['master', 'gerente', 'tesouraria', 'operador'])
        && (
          (resource.data.status == 'rascunho'
            && request.resource.data.status in ['rascunho', 'enviado_aprovacao'])
          ||
          (resource.data.status == 'devolvido'
            && request.resource.data.status in ['devolvido', 'enviado_aprovacao'])
        );
    }

    function treasuryExpenseClose() {
      return hasRole(['master', 'tesouraria'])
        && (
          (resource.data.status == 'aprovado'
            && request.resource.data.status in ['aprovado', 'pago'])
          ||
          (resource.data.status == 'pago'
            && request.resource.data.status in ['pago', 'arquivado'])
        );
    }

    function originReceivableUpdate() {
      return hasRole(['master', 'gerente', 'operador'])
        && (
          (resource.data.status == 'rascunho'
            && request.resource.data.status in ['rascunho', 'enviado_tesouraria'])
          ||
          (resource.data.status == 'devolvido'
            && request.resource.data.status in ['devolvido', 'enviado_tesouraria'])
        );
    }

    function treasuryReceivableUpdate() {
      return hasRole(['master', 'tesouraria'])
        && (
          (resource.data.status == 'enviado_tesouraria'
            && request.resource.data.status in ['enviado_tesouraria', 'recebido_tesouraria', 'devolvido'])
          ||
          (resource.data.status == 'recebido_tesouraria'
            && request.resource.data.status in ['recebido_tesouraria', 'encerrado'])
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || hasRole(['master']));
      allow create: if validSelfRegistration(userId);
      allow update: if signedIn() && (
        (request.auth.uid == userId && safeSelfUpdate())
        || hasRole(['master'])
      );
      allow delete: if hasRole(['master']) && request.auth.uid != userId;
    }

    match /userInvites/{document=**} {
      allow read, write: if false;
    }

    match /expenses/{document=**} {
      allow read: if activeUser();
      allow create: if hasRole(['master', 'gerente', 'tesouraria', 'operador'])
        && request.resource.data.status in ['rascunho', 'enviado_aprovacao'];
      allow update: if directorExpenseDecision()
        || operationalExpenseUpdate()
        || treasuryExpenseClose();
      allow delete: if hasRole(['master'])
        || (hasRole(['gerente', 'tesouraria', 'operador'])
          && resource.data.status == 'rascunho'
          && resource.data.createdBy == request.auth.uid);
    }

    match /receivables/{document=**} {
      allow read: if activeUser();
      allow create: if hasRole(['master', 'gerente', 'operador'])
        && request.resource.data.status in ['rascunho', 'enviado_tesouraria'];
      allow update: if originReceivableUpdate() || treasuryReceivableUpdate();
      allow delete: if hasRole(['master']);
    }

    match /approvals/{document=**} {
      allow read: if activeUser();
      allow create, update: if isDirectorEmail() && hasRole(['diretor']);
      allow delete: if hasRole(['master']);
    }

    match /chartOfAccounts/{document=**} {
      allow read: if activeUser();
      allow write: if isPrimaryAdminEmail() && hasRole(['master']);
    }

    match /accountingDispatches/{document=**} {
      allow read: if hasRole(['master', 'diretor', 'gerente', 'tesouraria']);
      allow create: if hasRole(['master', 'gerente', 'tesouraria']);
      allow update, delete: if hasRole(['master']);
    }

    // Coleção antiga mantida apenas para compatibilidade/limpeza de registros já existentes.
    match /accountingPackages/{document=**} {
      allow read: if hasRole(['master', 'diretor', 'gerente', 'tesouraria']);
      allow create: if false;
      allow update, delete: if hasRole(['master']);
    }

    match /bankStatements/{document=**} {
      allow read: if hasRole(['master', 'diretor', 'gerente', 'tesouraria']);
      allow create, update: if hasRole(['master', 'gerente', 'tesouraria']);
      allow delete: if hasRole(['master', 'gerente', 'tesouraria']);
    }

    match /auditLogs/{document=**} {
      allow read: if hasRole(['master', 'diretor', 'gerente']);
      allow create: if activeUser();
      allow update: if false;
      allow delete: if isPrimaryAdminEmail() && hasRole(['master']);
    }

    match /settings/{document=**} {
      allow read: if activeUser();
      allow write: if hasRole(['master']);
    }
  }
}
